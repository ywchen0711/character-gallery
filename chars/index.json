    {
      "id": "josh",
      "name": {
        "zh": "喬許",
        "en": "Josh"
      },
      "style_name": {
        "zh": "盾手",
        "en": "Shieldbearer"
      },
      "title": {
        "zh": "熱心腸的盾牌",
        "en": "The big-hearted shield"
      },
      "bio": {
        "zh": "個子最大、心腸最軟的水手。打仗時他舉著那面從船上拆下來的圓盾站在最前面，大聲挑釁把敵人引到自己身上，好讓同伴喘口氣。愛笑，也愛吃江東的魚。",
        "en": "The biggest sailor with the softest heart. In battle he stands in front behind the round shield he pried off the wreck, shouting to pull every enemy onto himself so his friends can breathe. Laughs easily and loves Jiangdong fish."
      },
      "weapon": {
        "zh": "鐵槍與圓盾",
        "en": "Iron spear and round shield"
      },
