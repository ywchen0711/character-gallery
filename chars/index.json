    {
      "id": "guanyu",
      "name": {
        "zh": "關羽",
        "en": "Guan Yu"
      },
      "style_name": {
        "zh": "雲長",
        "en": "Yunchang"
      },
      "title": {
        "zh": "美髯公",
        "en": "Lord of the Beautiful Beard"
      },
      "bio": {
        "zh": "河東解良人，與劉備、張飛結為兄弟。赤面長髯，綠巾綠袍，手持青龍偃月刀。重義守信，千里尋兄的故事流傳至今。",
        "en": "A man of Xieliang in Hedong, sworn brother of Liu Bei and Zhang Fei. Red-faced and long-bearded, in a green headscarf and robe, he carries the Green Dragon Crescent Blade. His loyalty is remembered in the tale of riding a thousand li to rejoin his brother."
      },
      "weapon": {
        "zh": "青龍偃月刀",
        "en": "Green Dragon Crescent Blade"
      },
