    {
      "id": "jeff",
      "name": {
        "zh": "傑夫",
        "en": "Jeff"
      },
      "style_name": {
        "zh": "船匠",
        "en": "Shipwright"
      },
      "title": {
        "zh": "造火船的軍師",
        "en": "The strategist who builds fire rafts"
      },
      "bio": {
        "zh": "船匠兼工程師，四人之中的軍師。眼鏡在船難裡裂了一角，扳手卻一直插在腰間。他看得懂江東的船，也看得懂風向，第一個想到把整條船變成火龍衝進敵陣。",
        "en": "Shipwright, engineer and the strategist of the four. His glasses cracked in the wreck, but the wrench never left his belt. He reads Jiangdong hulls as well as the wind, and was the first to think of turning a whole boat into a fire dragon and sailing it into the enemy line."
      },
      "weapon": {
        "zh": "扳手與火龍船",
        "en": "Wrench and fire rafts"
      },
      "faction": "west",
      "factionName": {
        "zh": "西洋旅人",
        "en": "Western travellers"
      },
