    {
      "id": "jasper",
      "name": {
        "zh": "賈斯珀",
        "en": "Jasper"
      },
      "style_name": {
        "zh": "斥候",
        "en": "Scout"
      },
      "title": {
        "zh": "眼尖的斥候",
        "en": "The sharp-eyed scout"
      },
      "bio": {
        "zh": "四位西洋旅人中最年輕的一個，船難後在江東跟著孫權。腳快、眼尖、手也快：地圖上的祕密總是他先發現，短弓與箭袋從不離身，脖子上的圍巾是在建業市集換來的。",
        "en": "The youngest of the four western travellers, who followed Sun Quan after the wreck. Quick feet, sharp eyes and quicker fingers: he finds the map's secrets first, never parts with his short bow and quiver, and traded for the scarf at his neck in a Jianye market."
      },
      "weapon": {
        "zh": "短弓",
        "en": "Short bow"
      },
