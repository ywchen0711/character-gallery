    {
      "id": "josh",
      "name": {
        "zh": "喬許",
        "en": "Josh"
      },
      "style_name": {
        "zh": "盾手",
        "en": "Shieldbearer"
      },
      "title": {
        "zh": "熱心腸的盾牌",
        "en": "The big-hearted shield"
      },
      "bio": {
        "zh": "十歲的哥哥，勇敢又熱心。背著小木盾、拿著木棍，總是站在弟弟前面，大聲喊話把壞人引到自己身上。笑起來露出缺了一顆的門牙。",
        "en": "The ten-year-old big brother, brave and warm-hearted. With his little wooden shield and stick he always stands in front of his brother, shouting to draw trouble onto himself. His grin shows a missing tooth."
      },
      "weapon": {
        "zh": "小木盾與木棍",
        "en": "Little wooden shield and stick"
      },
