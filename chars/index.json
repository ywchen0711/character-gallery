    {
      "id": "jasper",
      "name": {
        "zh": "賈斯珀",
        "en": "Jasper"
      },
      "style_name": {
        "zh": "斥候",
        "en": "Scout"
      },
      "title": {
        "zh": "眼尖的斥候",
        "en": "The sharp-eyed scout"
      },
      "bio": {
        "zh": "八歲的弟弟，一家人裡最小也最快。眼尖手巧，背著小布包、拿著彈弓，地圖上的祕密總是他先發現；頭上兩個小髻是媽媽每天早上替他綁的。",
        "en": "The eight-year-old little brother, smallest and quickest of the family. Sharp eyes, quick hands, a satchel and a slingshot: he finds the map's secrets first. Mum ties his two little hair buns every morning."
      },
      "weapon": {
        "zh": "彈弓",
        "en": "Slingshot"
      },
